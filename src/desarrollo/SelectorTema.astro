---
// Selector de temas. Sólo existe con npm run dev (Base.astro lo incluye bajo
// import.meta.env.DEV); el sitio publicado no lo lleva. Cambia el tema y el modo
// sin recargar, y recuerda la elección en este navegador.
// También acepta ?tema=a&modo=oscuro en la dirección (lo usan las capturas).
import { TEMAS } from './temas.mjs';
import { url } from '../lib/rutas';

const temas = TEMAS.map((t) => ({ id: t.id, nombre: t.nombre }));
const lamina = url('/temas/');
---
<script is:inline define:vars={{ temas, lamina }}>
  const raiz = document.documentElement;
  const guardado = (clave) => { try { return localStorage.getItem(clave); } catch { return null; } };
  const guardar = (clave, valor) => { try { localStorage.setItem(clave, valor); } catch {} };
  const params = new URLSearchParams(location.search);

  function aplicar(tema, modo) {
    if (temas.some((t) => t.id === tema)) raiz.dataset.tema = tema;
    if (modo === 'claro' || modo === 'oscuro') raiz.dataset.modo = modo;
    else delete raiz.dataset.modo;
  }
  aplicar(params.get('tema') ?? guardado('tema-dev'), params.get('modo') ?? guardado('modo-dev'));

  document.addEventListener('DOMContentLoaded', () => {
    const caja = document.createElement('form');
    caja.className = 'selector-tema';
    caja.setAttribute('aria-label', 'Selector de tema (sólo en desarrollo)');
    caja.innerHTML = `
      <span class="selector-tema-titulo">Tema · sólo en desarrollo</span>
      <label>Tema <select name="tema">${temas.map((t) => `<option value="${t.id}">${t.nombre}</option>`).join('')}</select></label>
      <label>Modo <select name="modo"><option value="">Sistema</option><option value="claro">Claro</option><option value="oscuro">Oscuro</option></select></label>
      <a href="${lamina}">Lámina</a>`;
    caja.tema.value = raiz.dataset.tema;
    caja.modo.value = raiz.dataset.modo ?? '';
    caja.addEventListener('change', () => {
      aplicar(caja.tema.value, caja.modo.value);
      guardar('tema-dev', caja.tema.value);
      guardar('modo-dev', caja.modo.value);
    });
    caja.addEventListener('submit', (e) => e.preventDefault());
    document.body.append(caja);
  });
</script>
<style is:inline>
  .selector-tema {
    position: fixed; left: 0.75rem; bottom: 0.75rem; z-index: 2000;
    display: grid; grid-template-columns: repeat(3, auto); align-items: center; gap: 0.35rem 0.75rem;
    max-width: calc(100vw - 1.5rem); padding: 0.5rem 0.75rem;
    font-family: var(--fuente-interfaz); font-size: 0.85rem; line-height: 1.3;
    background: var(--color-superficie); color: var(--color-texto);
    border: 1px solid var(--color-borde); border-radius: var(--radio);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.18);
  }
  .selector-tema-titulo { grid-column: 1 / -1; color: var(--color-texto-suave); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .selector-tema select { font: inherit; margin-left: 0.25rem; }
</style>
