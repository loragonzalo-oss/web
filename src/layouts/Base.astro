---
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import SelectorTema from '../desarrollo/SelectorTema.astro';
import { TEMA } from '../../sitio.config.mjs';
import { SITIO } from '../lib/sitio';
import { url, urlAbsoluta } from '../lib/rutas';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;          // ruta ya resuelta (por ejemplo, de una imagen optimizada)
  tipo?: 'website' | 'article';
  fecha?: Date;
  noIndexar?: boolean;
}

const { titulo, descripcion = SITIO.descripcion, imagen, tipo = 'website', fecha, noIndexar = false } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${SITIO.nombre}` : `${SITIO.nombre} · «${SITIO.apodo}»`;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const imagenOG = imagen ? new URL(imagen, Astro.site).href : urlAbsoluta('/og-default.png', Astro.site);
---
<!doctype html>
<html lang={SITIO.idioma} data-tema={TEMA}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {!noIndexar && <link rel="canonical" href={canonica} />}
    {noIndexar && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`Blog de ${SITIO.nombre}`} href={urlAbsoluta('/rss.xml', Astro.site)} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    {import.meta.env.DEV && <SelectorTema />}

    <!-- Open Graph (Facebook) -->
    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:locale" content="es_BO" />
    <meta property="og:title" content={titulo ?? SITIO.nombre} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenOG} />
    {!imagen && <meta property="og:image:width" content="1200" />}
    {!imagen && <meta property="og:image:height" content="630" />}
    {fecha && <meta property="article:published_time" content={fecha.toISOString()} />}

    <!-- X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITIO.usuarioX} />
    <meta name="twitter:title" content={titulo ?? SITIO.nombre} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenOG} />
  </head>
  <body>
    <a class="salto" href="#contenido">Saltar al contenido</a>
    <Cabecera />
    <main id="contenido" class="contenedor">
      <slot />
    </main>
    <Pie />
  </body>
</html>
