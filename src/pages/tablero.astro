---
// Tablero de indicadores del Lago Titikaka. Datos: src/content/tablero/ (un YAML por versión).
// Mientras la versión vigente sea borrador (draft: true), el sitio publicado muestra sólo
// «en preparación», sin cifras ni rosa; en desarrollo y en la construcción de prueba se ve
// todo. Cómo se actualiza: docs/tablero/COMO-ACTUALIZAR.md.
import Base from '../layouts/Base.astro';
import Rosa from '../components/tablero/Rosa.astro';
import Leyenda from '../components/tablero/Leyenda.astro';
import Tabla from '../components/tablero/Tabla.astro';
import Texto from '../components/tablero/Texto.astro';
import Trozos from '../components/tablero/Trozos.astro';
import { verBorradores } from '../lib/borradores';
import { fechaISO, fechaLarga } from '../lib/fechas';
import { url } from '../lib/rutas';
import { enLinea, tablero, tienePendiente } from '../lib/tablero';

const { versiones, vigente, petalos } = await tablero();
const v = vigente.data;
const mostrar = verBorradores || !v.draft;
const textos = v.textos!;
const titulo = 'Tablero de indicadores del Lago Titikaka';
// La imagen para compartir existe sólo cuando la versión no es borrador (src/pages/og/tablero.png.ts).
const imagen = v.draft ? undefined : url('/og/tablero.png');
---
{mostrar ? (
  <Base
    titulo={titulo}
    descripcion={`Propuesta en curso de Gonzalo R. Lora Veizaga: ${petalos.length} indicadores del Lago Titikaka y su cuenca, cada uno medido contra su propio límite. ${v.nombre}, ${fechaLarga(v.fecha)}.`}
    imagen={imagen}
    noIndexar={v.draft}
  >
    <article class="tablero" data-pagefind-body={v.draft ? undefined : true}>
      {v.draft && <p class="borrador-aviso lectura">Borrador: sólo se ve en el modo de desarrollo y en la construcción de prueba. En el sitio publicado esta página dice «en preparación».</p>}
      <header class="lectura">
        <h1>{titulo}</h1>
        <p class:list={['tablero-rotulo', 'interfaz', { relleno: tienePendiente(textos.rotulo) }]}><Trozos trozos={enLinea(textos.rotulo)} /></p>
        <p class="meta">{v.nombre} ({v.version}) · versión del <time datetime={fechaISO(v.fecha)}>{fechaLarga(v.fecha)}</time></p>
        <div class:list={['tablero-intro', { relleno: tienePendiente(textos.introduccion) }]}><Texto texto={textos.introduccion} /></div>
      </header>

      <figure class="tablero-figura" aria-describedby="regla-lectura">
        <Rosa petalos={petalos} variables={v.variables} anio={String(v.fecha.getUTCFullYear())} version={v.nombre} />
        <figcaption id="regla-lectura" class="lectura"><Trozos trozos={enLinea(textos.regla_lectura)} /></figcaption>
      </figure>

      <Leyenda />

      <section aria-labelledby="indicadores">
        <h2 id="indicadores" class="lectura">Los indicadores</h2>
        <Tabla petalos={petalos} variables={v.variables} />
      </section>

      <section class="lectura" aria-labelledby="metodo">
        <h2 id="metodo">Método y fuentes</h2>
        <p class="meta">Nota de la versión del <time datetime={fechaISO(v.fecha)}>{fechaLarga(v.fecha)}</time> ({v.version}).</p>
        <div class:list={{ relleno: tienePendiente(textos.metodo) }}><Texto texto={textos.metodo} /></div>
        {textos.metodo_apoyo && <div class:list={['tablero-apoyo', { relleno: tienePendiente(textos.metodo_apoyo) }]}><Texto texto={textos.metodo_apoyo} /></div>}
        <h3>Fuentes</h3>
        <ul class="tablero-fuentes">
          {textos.fuentes.map((f) => <li><Trozos trozos={enLinea(f)} /></li>)}
        </ul>
      </section>

      <section class="lectura" aria-labelledby="historial">
        <h2 id="historial">Historial de versiones</h2>
        <ul class="tablero-historial">
          {versiones.map((h) => (
            <li>
              <p class="tablero-historial-titulo">
                <strong>{h.data.nombre}</strong> · <time datetime={fechaISO(h.data.fecha)}>{fechaLarga(h.data.fecha)}</time>
                {h.id === vigente.id && <span class="meta"> · versión vigente, en esta página</span>}
              </p>
              <p>{h.data.cambios}</p>
              {h.data.herramienta && <p class="meta">Hecha con {h.data.herramienta}.</p>}
            </li>
          ))}
        </ul>
      </section>
    </article>
  </Base>
) : (
  <Base titulo={`${titulo} · en preparación`} descripcion={`${titulo}, en preparación.`} noIndexar>
    <article class="lectura tablero-vacio">
      <p class="meta">En preparación</p>
      <h1>{titulo}</h1>
    </article>
  </Base>
)}

<style>
  .tablero-rotulo {
    font-size: var(--tam-chico);
    padding: 0.6em 0.9em;
    border-left: 3px solid var(--color-acento);
    background: var(--color-superficie);
    border-radius: 0 var(--radio) var(--radio) 0;
  }
  .tablero-figura { margin: 2rem 0 0; }
  .tablero-figura figcaption {
    margin-top: 1.5rem;
    font-family: var(--fuente-interfaz);
    font-size: var(--tam-chico);
    color: var(--color-texto);
  }
  .tablero section > h2 { margin-top: 2.5em; }
  .tablero-apoyo { font-size: 0.95em; }
  .relleno { border: 1px solid var(--color-pendiente-texto); border-radius: var(--radio); padding: 0 0.9em; margin: 1em 0; }
  .tablero-rotulo.relleno { padding: 0.6em 0.9em; border-left-width: 3px; border-left-style: solid; }
  .tablero-fuentes { padding-left: 0; list-style: none; }
  .tablero-fuentes li { padding-left: 1.5em; text-indent: -1.5em; margin-bottom: 0.5em; }
  .tablero-historial { padding-left: 0; list-style: none; }
  .tablero-historial li { margin-bottom: 1.25em; }
  .tablero-historial p { margin: 0.2em 0; }
</style>
