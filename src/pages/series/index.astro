---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/rutas';
import { series } from '../../lib/lectura';

const lista = await series();
---
<Base titulo="Series" descripcion="Series de textos de Gonzalo R. Lora Veizaga, para leer en orden.">
  <section class="lectura">
    <h1>Series</h1>
    <p class="meta">Textos del blog y ensayos que se leen en orden.</p>
    {lista.length === 0 ? (
      <p class="vacio">Todavía no hay series publicadas.</p>
    ) : (
      <ul class="lista">
        {lista.map((s) => (
          <li>
            <h2><a href={url(`/series/${s.slug}/`)}>{s.nombre}</a></h2>
            <p class="meta">{s.textos.length === 1 ? '1 texto' : `${s.textos.length} textos`}</p>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .lista { list-style: none; margin: 2rem 0 0; padding: 0; }
  li { padding: 1.2rem 0; border-bottom: 1px solid var(--color-borde); }
  h2 { margin: 0 0 0.2rem; font-size: var(--tam-h3); }
  h2 a { color: var(--color-texto); text-decoration: none; }
  h2 a:hover { color: var(--color-acento); }
  .meta { margin: 0; }
</style>
