---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/rutas';
import { fechaLarga, fechaISO } from '../../lib/fechas';
import { ensayos } from '../../lib/contenido';

export const getStaticPaths = (async () => {
  const lista = await ensayos();
  return lista.map((e) => ({ params: { ensayo: e.id }, props: { e } }));
}) satisfies GetStaticPaths;

const { e } = Astro.props;
const { Content } = await render(e);
---
<Base titulo={e.data.titulo} descripcion={e.data.resumen} tipo="article" fecha={e.data.fecha} noIndexar={e.data.draft}>
  <article class="lectura">
    {e.data.draft && <p class="borrador-aviso">Borrador: sólo se ve en el modo de desarrollo. No se publica.</p>}
    <header>
      <p class="meta">Ensayo · <time datetime={fechaISO(e.data.fecha)}>{fechaLarga(e.data.fecha)}</time></p>
      <h1>{e.data.titulo}</h1>
      <p class="resumen">{e.data.resumen}</p>
      {e.data.publicacion && (
        <p class="meta publicacion">
          Publicado en <em>{e.data.publicacion}</em>
          {e.data.enlace && <> · <a href={e.data.enlace}>ver publicación original</a></>}
        </p>
      )}
    </header>
    <div class="cuerpo"><Content /></div>
    <footer>
      <p class="interfaz"><a href={url('/ensayos/')}>← Volver a ensayos</a></p>
    </footer>
  </article>
</Base>

<style>
  .resumen { font-size: 1.15em; color: var(--color-texto-suave); font-style: italic; }
  .publicacion { border-top: 1px solid var(--color-borde); border-bottom: 1px solid var(--color-borde); padding: 0.6rem 0; margin: 1.5rem 0 2rem; }
  footer { margin-top: 3rem; border-top: 1px solid var(--color-borde); padding-top: 1rem; }
</style>
