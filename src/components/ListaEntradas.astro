---
import type { CollectionEntry } from 'astro:content';
import { url, slugEtiqueta } from '../lib/rutas';
import { fechaLarga, fechaISO } from '../lib/fechas';

interface Props {
  entradas: CollectionEntry<'blog'>[];
  vacio?: string;
}
const { entradas, vacio = 'Todavía no hay entradas publicadas.' } = Astro.props;
---
{entradas.length === 0 ? (
  <p class="vacio">{vacio}</p>
) : (
  <ul class="lista">
    {entradas.map((e) => (
      <li>
        <p class="meta">
          <time datetime={fechaISO(e.data.fecha)}>{fechaLarga(e.data.fecha)}</time>
          {e.data.draft && <span> · borrador</span>}
        </p>
        <h3><a href={url(`/blog/${e.id}/`)}>{e.data.titulo}</a></h3>
        {e.data.resumen && <p class="resumen">{e.data.resumen}</p>}
        {e.data.etiquetas.length > 0 && (
          <p class="meta etiquetas">
            {e.data.etiquetas.map((t) => <a href={url(`/blog/etiquetas/${slugEtiqueta(t)}/`)}>#{t}</a>)}
          </p>
        )}
      </li>
    ))}
  </ul>
)}

<style>
  .lista { list-style: none; margin: 0; padding: 0; }
  li { padding: 1.4rem 0; border-bottom: 1px solid var(--color-borde); }
  li:first-child { padding-top: 0; }
  h3 { margin: 0.2rem 0 0.4rem; }
  h3 a { color: var(--color-texto); text-decoration: none; }
  h3 a:hover { color: var(--color-acento); }
  .meta { margin: 0; }
  .resumen { margin: 0 0 0.4rem; }
  .etiquetas { display: flex; flex-wrap: wrap; gap: 0.8rem; }
</style>
