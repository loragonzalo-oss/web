---
// «Textos relacionados»: entradas del blog y ensayos que comparten etiquetas con este texto.
import { rutaTexto, type Texto } from '../lib/lectura';
import { fechaLarga, fechaISO } from '../lib/fechas';

interface Props { textos: Texto[] }
const { textos } = Astro.props;
---
{textos.length > 0 && (
  <section class="relacionados" aria-labelledby="titulo-relacionados">
    <h2 id="titulo-relacionados" class="interfaz">Textos relacionados</h2>
    <ul>
      {textos.map((t) => (
        <li>
          <a href={rutaTexto(t)}>{t.data.titulo}</a>
          <span class="meta"> · {t.collection === 'ensayos' && <>Ensayo · </>}<time datetime={fechaISO(t.data.fecha)}>{fechaLarga(t.data.fecha)}</time></span>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .relacionados { margin-top: 2.5rem; }
  h2 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-texto-suave); margin: 0 0 0.6rem; font-weight: 600; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { padding: 0.45rem 0; border-bottom: 1px solid var(--color-borde); }
</style>
