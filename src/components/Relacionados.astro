---
// «Textos relacionados»: entradas del blog que comparten etiquetas con esta.
import type { CollectionEntry } from 'astro:content';
import { rutaTexto } from '../lib/lectura';
import { fechaLarga, fechaISO } from '../lib/fechas';

interface Props { entradas: CollectionEntry<'blog'>[] }
const { entradas } = Astro.props;
---
{entradas.length > 0 && (
  <section class="relacionados" aria-labelledby="titulo-relacionados">
    <h2 id="titulo-relacionados" class="interfaz">Textos relacionados</h2>
    <ul>
      {entradas.map((e) => (
        <li>
          <a href={rutaTexto(e)}>{e.data.titulo}</a>
          <span class="meta"> · <time datetime={fechaISO(e.data.fecha)}>{fechaLarga(e.data.fecha)}</time></span>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .relacionados { margin-top: 2.5rem; }
  h2 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-texto-suave); margin: 0 0 0.6rem; font-weight: 600; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { padding: 0.45rem 0; border-bottom: 1px solid var(--color-borde); }
</style>
