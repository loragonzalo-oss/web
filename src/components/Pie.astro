---
import { SITIO } from '../lib/sitio';
import { url } from '../lib/rutas';
const anio = new Date().getFullYear();
---
<footer class="pie">
  <div class="contenedor pie-fila">
    <p>© {anio} {SITIO.nombre}</p>
    <ul>
      <li><a href={SITIO.redes.x} rel="me">X</a></li>
      <li><a href={SITIO.redes.facebook} rel="me">Facebook</a></li>
      <li><a href={url('/rss.xml')}>RSS</a></li>
    </ul>
  </div>
</footer>

<style>
  .pie {
    margin-top: 5rem;
    border-top: 1px solid var(--color-borde);
    font-family: var(--fuente-interfaz);
    font-size: var(--tam-chico);
    color: var(--color-texto-suave);
  }
  .pie-fila { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; padding-top: 1.5rem; padding-bottom: 2rem; }
  p { margin: 0; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.2rem; }
  a { color: var(--color-texto-suave); }
  a:hover { color: var(--color-acento); }
</style>
